{
    "name": "handy-node-scripts",
    "version": "0.0.2",
    "private": false,
    "scripts": {
        "generate": "node ./src/generate.js && npm run rebuild-component-index",
        "generate-types": ". ../../.env.local && cf-content-types-generator --v10 --spaceId $CONTENTFUL_SPACE_ID --token $CONTENTFUL_MANAGEMENT_ACCESS_TOKEN --out ../../src/lib/contentfulTypes",
        "rebuild-component-index": "node ./src/rebuild-component-index.js",
        "upgrade-react-19": "npm install --save-exact react@rc react-dom@rc babel-plugin-react-compiler@latest --force"
    },
    "dependencies": {
        "enquirer": "^2.4.1",
        "eslint": "^9.6.0",
        "lodash": "^4.17.21",
        "tiny-invariant": "^1.3.3"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.9",
        "@types/node": "^22",
        "eslint": "^9",
        "prettier": "^3.3.3"
    }
  }
